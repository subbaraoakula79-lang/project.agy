# ============================================================
# YatraSeva — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in values.
# NEVER commit .env files with real secrets.
# ============================================================

# ---- General ----
NODE_ENV=development
PORT=3000
APP_NAME=YatraSeva

# ---- Database ----
DATABASE_URL=file:./dev.db

# ---- JWT / Auth ----
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# ---- Service Providers (mock | real) ----
OTP_PROVIDER=mock
PAYMENT_PROVIDER=mock
MAP_PROVIDER=mock
NOTIFICATION_PROVIDER=mock

# ---- Mock OTP (development only) ----
MOCK_OTP_CODE=123456

# ---- Rate Limiting ----
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ---- CORS ----
CORS_ORIGIN=http://localhost:3001

# ---- WebSocket ----
WS_PORT=3002
WS_CORS_ORIGIN=http://localhost:3001

# ---- Real Provider Config (unused when providers are 'mock') ----
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# GOOGLE_MAPS_API_KEY=

# FCM_SERVER_KEY=
# FCM_PROJECT_ID=

# ---- Admin ----
ADMIN_DEFAULT_EMAIL=admin@yatraseeva.com
ADMIN_DEFAULT_PASSWORD=admin123
