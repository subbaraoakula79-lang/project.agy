# ============================================================
# YatraSeva Rider Mobile — Environment Configuration
# ============================================================
# Copy this file to .env and update values for your environment.
# These variables are PUBLIC (bundled into the app).
# NEVER put backend secrets here.
# ============================================================

# ---- API URL (Public, bundled into app) ----
EXPO_PUBLIC_API_URL=http://192.168.1.100:3000

# ---- WebSocket URL (Public, bundled into app) ----
EXPO_PUBLIC_WS_URL=http://192.168.1.100:3000
