# ============================================================
# YatraSeva Admin Web — Environment Configuration
# ============================================================
# Copy this file to .env.local and update values for your environment.
# NEXT_PUBLIC_ variables are exposed to the browser.
# NEVER put backend secrets here.
# ============================================================

# ---- API URL (Public, exposed to browser) ----
NEXT_PUBLIC_API_URL=http://localhost:3000

# ---- WebSocket URL (Public, exposed to browser) ----
NEXT_PUBLIC_WS_URL=http://localhost:3000
