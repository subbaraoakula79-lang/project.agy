// ================================================================
// YatraSeva — Prisma Schema
// ================================================================
// Using PostgreSQL (Neon) for all environments.
// DATABASE_URL must be a server-side environment variable.
// ================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────────
// USER & PROFILES
// ────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(uuid())
  phoneNumber   String?   @unique
  email         String?   @unique
  passwordHash  String?   // Only for ADMIN users
  firstName     String?
  lastName      String?
  role          String    // UserRole enum: RIDER, DRIVER, ADMIN
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  riderProfile  RiderProfile?
  driverProfile DriverProfile?
  notifications Notification[]
  deviceTokens  DeviceToken[]
  ridesAsRider  Ride[]    @relation("RiderRides")
  payments      Payment[] @relation("RiderPayments")
  ratingsGiven  Rating[]  @relation("RaterRatings")
  ratingsReceived Rating[] @relation("RateeRatings")

  reportedSafetyEvents SafetyEvent[] @relation("ReportedSafetyEvents")
  resolvedSafetyEvents SafetyEvent[] @relation("ResolvedSafetyEvents")
  tripShares          TripShare[]
  createdSupportTickets SupportTicket[] @relation("CreatedSupportTickets")
  resolvedSupportTickets SupportTicket[] @relation("ResolvedSupportTickets")
  reportedIncidents   Incident[] @relation("ReportedIncidents")
  resolvedIncidents   Incident[] @relation("ResolvedIncidents")

  @@index([role])
  @@index([phoneNumber])
}

model RiderProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  preferredPayment String  @default("CASH") // PaymentMethod enum
  totalRides      Int      @default(0)
  averageRating   Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DriverProfile {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id])
  cityId          String
  city            City      @relation(fields: [cityId], references: [id])
  status          String    @default("OFFLINE") // DriverStatus enum (availability)
  verificationStatus String @default("PENDING") // VerificationStatus enum (onboarding lifecycle)
  isVerified      Boolean   @default(false)
  isOnboarded     Boolean   @default(false)
  currentLatitude Float?
  currentLongitude Float?
  lastLocationAt  DateTime?
  totalRides      Int       @default(0)
  averageRating   Float     @default(0)
  totalEarnings   Float     @default(0)
  rejectionReason String?
  suspensionReason String?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  suspendedAt     DateTime?
  approvedByUserId String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  vehicles        Vehicle[]
  documents       DriverDocument[]
  rides           Ride[]    @relation("DriverRides")
  locationHistory DriverLocation[]
  rideRequests    DriverRideRequest[]

  @@index([cityId, status])
  @@index([status])
  @@index([verificationStatus])
}

// ────────────────────────────────────────────────────────────────
// VEHICLES & DOCUMENTS
// ────────────────────────────────────────────────────────────────

model VehicleType {
  id          String   @id @default(uuid())
  name        String   @unique // BIKE, AUTO, CAB
  displayName String   // "Bike", "Auto Rickshaw", "Cab"
  maxPassengers Int
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vehicles    Vehicle[]
  pricingConfigs PricingConfig[]
}

model Vehicle {
  id              String        @id @default(uuid())
  driverProfileId String
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id])
  vehicleTypeId   String
  vehicleType     VehicleType   @relation(fields: [vehicleTypeId], references: [id])
  registrationNumber String     @unique
  make            String?
  model           String?
  year            Int?
  color           String?
  isActive        Boolean       @default(true)
  isDefault       Boolean       @default(false)
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  rides           Ride[]

  @@index([driverProfileId])
  @@index([vehicleTypeId])
}

model DriverDocument {
  id              String        @id @default(uuid())
  driverProfileId String
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id])
  type            String        // DocumentType enum
  documentNumber  String?       // Document reference/ID number
  documentUrl     String
  status          String        @default("PENDING") // DocumentStatus enum
  rejectionReason String?
  expiresAt       DateTime?
  verifiedAt      DateTime?
  reviewedByUserId String?      // Admin who reviewed
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([driverProfileId, type])
  @@index([driverProfileId, status])
}

// ────────────────────────────────────────────────────────────────
// RIDES & LOCATIONS
// ────────────────────────────────────────────────────────────────

model Ride {
  id              String        @id @default(uuid())
  riderId         String
  rider           User          @relation("RiderRides", fields: [riderId], references: [id])
  driverProfileId String?
  driverProfile   DriverProfile? @relation("DriverRides", fields: [driverProfileId], references: [id])
  vehicleId       String?
  vehicle         Vehicle?      @relation(fields: [vehicleId], references: [id])
  vehicleTypeId   String
  cityId          String
  city            City          @relation(fields: [cityId], references: [id])
  status          String        @default("REQUESTED") // RideStatus enum
  paymentMethod   String        @default("CASH") // PaymentMethod enum

  // Fare details
  estimatedFare   Float?
  actualFare      Float?
  estimatedDistanceMeters Int?
  actualDistanceMeters    Int?
  estimatedDurationSeconds Int?
  actualDurationSeconds    Int?
  surgeMultiplier Float         @default(1.0)

  // Timestamps for lifecycle analytics
  requestedAt     DateTime      @default(now())
  acceptedAt      DateTime?
  arrivingAt      DateTime?
  driverArrivedAt DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancellationReason String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  location        RideLocation?
  payment         Payment?
  ratings         Rating[]
  driverRequests  DriverRideRequest[]
  safetyEvents    SafetyEvent[]
  tripShares      TripShare[]
  supportTickets  SupportTicket[]
  incidents       Incident[]

  @@index([riderId])
  @@index([driverProfileId])
  @@index([status])
  @@index([cityId, status])
}

model RideLocation {
  id              String   @id @default(uuid())
  rideId          String   @unique
  ride            Ride     @relation(fields: [rideId], references: [id])
  pickupLatitude  Float
  pickupLongitude Float
  pickupAddress   String
  dropLatitude    Float
  dropLongitude   Float
  dropAddress     String
  routePolyline   String?  // Encoded polyline for map rendering
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ────────────────────────────────────────────────────────────────
// PAYMENTS
// ────────────────────────────────────────────────────────────────

enum PaymentMethod {
  CASH
  UPI
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

model Payment {
  id                String        @id @default(uuid())
  rideId            String        @unique
  ride              Ride          @relation(fields: [rideId], references: [id])
  riderId           String?
  rider             User?         @relation("RiderPayments", fields: [riderId], references: [id])
  amount            Float
  currency          String        @default("INR")
  method            PaymentMethod @default(CASH)
  provider          String        @default("mock")
  status            PaymentStatus @default(PENDING)
  providerPaymentId String?
  transactionId     String?       // External provider transaction ID
  failureReason     String?
  paidAt            DateTime?
  refundedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status])
  @@index([riderId])
}

// ────────────────────────────────────────────────────────────────
// RATINGS
// ────────────────────────────────────────────────────────────────

model Rating {
  id          String   @id @default(uuid())
  rideId      String
  ride        Ride     @relation(fields: [rideId], references: [id])
  raterUserId String
  raterUser   User     @relation("RaterRatings", fields: [raterUserId], references: [id])
  ratedUserId String
  ratedUser   User     @relation("RateeRatings", fields: [ratedUserId], references: [id])
  rating      Int      // 1-5 integer
  comment     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([rideId, raterUserId])
  @@index([ratedUserId])
  @@index([raterUserId])
  @@index([rideId])
}


// ────────────────────────────────────────────────────────────────
// CITY & PRICING
// ────────────────────────────────────────────────────────────────

model City {
  id          String   @id @default(uuid())
  name        String   @unique
  state       String
  country     String   @default("India")
  latitude    Float
  longitude   Float
  isActive    Boolean  @default(true)
  timezone    String   @default("Asia/Kolkata")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pricingConfigs PricingConfig[]
  driverProfiles DriverProfile[]
  rides          Ride[]
}

model PricingConfig {
  id              String      @id @default(uuid())
  cityId          String
  city            City        @relation(fields: [cityId], references: [id])
  vehicleTypeId   String
  vehicleType     VehicleType @relation(fields: [vehicleTypeId], references: [id])
  baseFare        Float       // Base fare in INR
  perKmRate       Float       // Rate per kilometer
  perMinRate      Float       // Rate per minute
  minimumFare     Float       // Minimum charge
  surgeMultiplier Float       @default(1.0)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([cityId, vehicleTypeId])
  @@index([cityId, vehicleTypeId])
}

// ────────────────────────────────────────────────────────────────
// DRIVER LOCATION & RIDE REQUESTS (PHASE 4)
// ────────────────────────────────────────────────────────────────

model DriverLocation {
  id              String        @id @default(uuid())
  driverProfileId String
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  latitude        Float
  longitude       Float
  accuracy        Float?
  heading         Float?
  speed           Float?
  recordedAt      DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([driverProfileId])
  @@index([driverProfileId, recordedAt])
}

enum DriverRideRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

model DriverRideRequest {
  id              String                  @id @default(uuid())
  rideId          String
  ride            Ride                    @relation(fields: [rideId], references: [id], onDelete: Cascade)
  driverProfileId String
  driverProfile   DriverProfile           @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  status          DriverRideRequestStatus @default(PENDING)
  expiresAt       DateTime
  respondedAt     DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([rideId, driverProfileId])
  @@index([driverProfileId, status])
  @@index([rideId, status])
}

// ────────────────────────────────────────────────────────────────
// NOTIFICATION & DEVICE TOKENS (PHASE 7A)
// ────────────────────────────────────────────────────────────────

enum NotificationType {
  RIDE_REQUESTED
  DRIVER_ASSIGNED
  DRIVER_ARRIVING
  DRIVER_ARRIVED
  RIDE_STARTED
  PAYMENT_PENDING
  PAYMENT_FAILED
  PAYMENT_COMPLETED
  RIDE_COMPLETED
  RIDE_CANCELLED
  DRIVER_RIDE_REQUEST
  RIDER_CANCELLED
  // Phase 8: Admin operations
  DRIVER_APPROVED
  DRIVER_REJECTED
  DRIVER_SUSPENDED
  RIDE_CANCELLED_BY_ADMIN
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
}

enum NotificationChannel {
  PUSH
  IN_APP
  SMS
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

model DeviceToken {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  token       String
  platform    DevicePlatform @default(ANDROID)
  appRole     String         // RIDER, DRIVER, ADMIN
  isActive    Boolean        @default(true)
  lastSeenAt  DateTime       @default(now())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([userId, token])
  @@index([userId, isActive])
  @@index([token])
}

model Notification {
  id            String              @id @default(uuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          NotificationType
  title         String
  body          String
  data          Json?
  channel       NotificationChannel @default(PUSH)
  status        NotificationStatus  @default(PENDING)
  failureReason String?
  retryCount    Int                 @default(0)
  sentAt        DateTime?
  readAt        DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// ────────────────────────────────────────────────────────────────
// ADMIN AUDIT LOG (PHASE 8)
// ────────────────────────────────────────────────────────────────

model AdminAuditLog {
  id            String   @id @default(uuid())
  adminUserId   String
  action        String   // DRIVER_APPROVED, DRIVER_REJECTED, DOCUMENT_APPROVED, etc.
  entityType    String   // DRIVER, DOCUMENT, VEHICLE, RIDE, CITY, PRICING
  entityId      String
  reason        String?
  metadata      Json?    // Safe operational metadata (no secrets)
  createdAt     DateTime @default(now())

  @@index([adminUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action])
}

// ────────────────────────────────────────────────────────────────
// SAFETY, SUPPORT & INCIDENT MANAGEMENT (PHASE 10)
// ────────────────────────────────────────────────────────────────

enum SafetyEventType {
  SOS_TRIGGERED
  SOS_RESOLVED
  TRIP_SHARED
  SAFETY_REPORT
}

enum SafetyEventStatus {
  ACTIVE
  RESOLVED
}

model SafetyEvent {
  id               String            @id @default(uuid())
  rideId           String
  ride             Ride              @relation(fields: [rideId], references: [id], onDelete: Cascade)
  reportedByUserId String
  reportedByUser   User              @relation("ReportedSafetyEvents", fields: [reportedByUserId], references: [id], onDelete: Cascade)
  type             SafetyEventType
  status           SafetyEventStatus @default(ACTIVE)
  description      String?
  resolvedAt       DateTime?
  resolvedByUserId String?
  resolvedByUser   User?             @relation("ResolvedSafetyEvents", fields: [resolvedByUserId], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([rideId])
  @@index([reportedByUserId])
  @@index([status])
  @@index([createdAt])
}

model TripShare {
  id               String   @id @default(uuid())
  rideId           String
  ride             Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  shareToken       String   @unique
  createdByUserId  String
  createdByUser    User     @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  @@index([rideId])
  @@index([shareToken])
  @@index([createdByUserId])
}

enum SupportTicketCategory {
  PAYMENT
  DRIVER
  RIDER
  RIDE
  SAFETY
  OTHER
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model SupportTicket {
  id               String                @id @default(uuid())
  createdByUserId  String
  createdByUser    User                  @relation("CreatedSupportTickets", fields: [createdByUserId], references: [id], onDelete: Cascade)
  rideId           String?
  ride             Ride?                 @relation(fields: [rideId], references: [id], onDelete: SetNull)
  category         SupportTicketCategory @default(OTHER)
  subject          String
  description      String
  status           SupportTicketStatus   @default(OPEN)
  priority         SupportTicketPriority @default(MEDIUM)
  resolvedAt       DateTime?
  resolvedByUserId String?
  resolvedByUser   User?                 @relation("ResolvedSupportTickets", fields: [resolvedByUserId], references: [id])
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([createdByUserId])
  @@index([rideId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
}

enum IncidentCategory {
  SAFETY
  DRIVER_BEHAVIOR
  RIDER_BEHAVIOR
  VEHICLE
  PAYMENT
  ACCIDENT
  OTHER
}

enum IncidentStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Incident {
  id               String           @id @default(uuid())
  rideId           String
  ride             Ride             @relation(fields: [rideId], references: [id], onDelete: Cascade)
  reportedByUserId String
  reportedByUser   User             @relation("ReportedIncidents", fields: [reportedByUserId], references: [id], onDelete: Cascade)
  category         IncidentCategory @default(SAFETY)
  severity         IncidentSeverity @default(MEDIUM)
  description      String
  status           IncidentStatus   @default(OPEN)
  resolvedAt       DateTime?
  resolvedByUserId String?
  resolvedByUser   User?            @relation("ResolvedIncidents", fields: [resolvedByUserId], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([rideId])
  @@index([reportedByUserId])
  @@index([status])
  @@index([severity])
  @@index([createdAt])
}
